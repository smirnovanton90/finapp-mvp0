# Пример переменных для локального запуска по HTTPS (вариант A — mkcert)
# Скопируйте нужные строки в .env.local (frontend) и .env (backend).
# Файлы .env* в репозитории не коммитятся.

# ---------- Frontend (frontend/.env.local) ----------
# NEXTAUTH_URL=https://localhost:3000
# NEXT_PUBLIC_BACKEND_URL=https://localhost:8000
# BACKEND_URL=https://localhost:8000
# NEXTAUTH_SECRET=любая-длинная-случайная-строка

# ---------- Backend (backend/.env) ----------
# PUBLIC_BASE_URL=https://localhost:8000
